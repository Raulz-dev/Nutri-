APP_NAME=+Saúde API
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mais_saude
SQL_ECHO=false
JWT_SECRET=troque-por-uma-chave-segura-com-pelo-menos-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7
PASSWORD_RESET_EXPIRATION_MINUTES=30
INVITATION_EXPIRATION_HOURS=24
CARE_INVITATION_EXPIRATION_DAYS=7
INVITATION_URL=http://localhost:5173/primeiro-acesso
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OUTBOX_ENCRYPTION_KEY=
METRICS_TOKEN=
AUTH_RATE_LIMIT=30
AUTH_ACCOUNT_RATE_LIMIT=5
AUTH_ACCOUNT_WINDOW_SECONDS=900
MAX_REQUEST_BYTES=1048576
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=nao-responda@maissaude.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
PASSWORD_RESET_URL=http://localhost:5173/redefinir-senha
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Piloto WhatsApp: somente backend. Use banco isolado e número de teste da Meta.
WHATSAPP_ENABLED=false
WHATSAPP_SENDS_ENABLED=false
# Preencha os campos abaixo antes de habilitar (não use valores vazios para UUID/lista).
# WHATSAPP_PILOT_NUTRITIONIST_ID=UUID_DO_PROFISSIONAL_FICTICIO
# WHATSAPP_PHONE_NUMBER_ID=ID_DO_NUMERO_DE_TESTE
# WHATSAPP_GRAPH_VERSION=vXX.0
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ALLOWED_PHONES=["55DDNUMERO"]
# Requer OUTBOX_ENCRYPTION_KEY para eventos recebidos criptografados.
# Webhook: https://SEU_HOST/api/v1/whatsapp/webhook
# API: --no-access-log; configure o proxy para não registrar query strings do webhook.
# Após alembic upgrade head: uv run python -m app.whatsapp.setup
# Worker separado: uv run python -m app.whatsapp.worker
# Pausar somente envios: WHATSAPP_SENDS_ENABLED=false e reiniciar API/worker.

# Tempo real do piloto: aplicar migração 20261029_0013.
# O proxy deve permitir Upgrade WebSocket em /api/v1/whatsapp/realtime.
# O LISTEN usa uma conexão PostgreSQL dedicada por aba; use conexão direta,
# sem pool em modo transação. Ticket de uso único segue no primeiro frame, nunca na URL.

# UazAPI: credenciais somente no backend. Não habilita envio nem configura webhooks.
# UAZAPI_BASE_URL=https://seu-servidor.uazapi.com
# UAZAPI_ADMIN_TOKEN=
# UAZAPI_WEBHOOK_BASE_URL=https://api.seu-dominio.com
# UAZAPI_INSTANCE_TOKEN=
# O vínculo por profissional é criado por app.cli.link_uazapi; veja o README.
UAZAPI_TIMEOUT_SECONDS=15
